{
  "manifest_version": 3,
  "name": "Radar — отправка заказов",
  "version": "0.4.0",
  "description": "Отправляет заказы и страницы в Radar в один клик или через контекстное меню.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "notifications"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Отправить в Radar",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "send-page": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Отправить текущую страницу в Radar"
    }
  }
}
